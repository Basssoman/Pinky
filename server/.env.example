# Copy to server/.env (git-ignored). Never commit real values.
# ONECLICK_API_KEY may also live in the repository-root .env (loaded as fallback).
# Order: real env vars, then $ENV_FILE, server/.env, the root .env (first
# non-empty value wins). Every value below is the default from src/config.ts;
# an empty value means "use the default" (shown in the comment).

# --- secrets (never commit, never log) ---
ONECLICK_API_KEY=
# ed25519:... key of RELAYER_ACCOUNT_ID
RELAYER_PRIVATE_KEY=

# --- NEAR ---
# sandbox | testnet | mainnet
NEAR_NETWORK=sandbox
# default: sandbox http://127.0.0.1:3030, testnet https://test.rpc.fastnear.com,
# mainnet https://free.rpc.fastnear.com
NEAR_RPC_URL=
# RPC for relayer sends (default: NEAR_RPC_URL). Use a separate, ideally paid
# RPC in production. Do NOT use rpc.mainnet.near.org (deprecated, answers 429).
NEAR_RPC_SEND_URL=
# max wait for one relayer send; then the server re-reads the chain and answers 504 relayer_timeout
RELAYER_SEND_TIMEOUT_SECONDS=120
# escrow contract account (required)
ESCROW_CONTRACT_ID=
# must equal the contract's relayer_id; needs NEAR for gas (required)
RELAYER_ACCOUNT_ID=

# --- HTTP ---
PORT=8787
HOST=127.0.0.1
# comma-separated origins in production; empty = * (dev)
CORS_ORIGIN=
# false | number of proxy hops (true = 1) | proxy addresses; only behind a reverse proxy
TRUST_PROXY=false
# default: server/data/escrow.sqlite (":memory:" for throwaway runs)
DB_PATH=
LOG_LEVEL=info

# --- 1Click ---
# default: https://1click.chaindefuser.com
ONECLICK_BASE_URL=
# Every quote is dry unless this is exactly "false" (or "0"). Real payments only after the human confirms.
ONECLICK_FORCE_DRY=true
ONECLICK_SLIPPAGE_BPS=100
# 1Click quote-signing key (default: the key hard-coded in the 1Click TypeScript SDK)
ONECLICK_QUOTE_PUBLIC_KEY=
QUOTE_DEADLINE_SECONDS=1800
WITHDRAW_EXPIRY_MARGIN_SECONDS=300
# INTENTS | CONFIDENTIAL_INTENTS (refundTo = the party's own implicit account)
PAYOUT_REFUND_TYPE=INTENTS
# NEP-141 asset id of the escrow token (default: nep141:17208628…6133a1 = NEAR-native USDC)
USDC_ASSET_ID=
TOKEN_SYMBOLS=USDC,USDT,ETH,SOL,BTC,GRAM,wNEAR,ZEC
# empty = all chains
TOKEN_CHAINS=

# --- deals ---
# largest / smallest accepted deal in USDC (never below the contract's 1 USDC)
MAX_DEAL_USDC=2000
MIN_DEAL_USDC=1
# every offer must carry exactly this fee_bps (300 = 3%, contract v2 allows <= 300)
FEE_BPS=300
# max offer (link) lifetime; tightened to the contract's max_offer_ttl_ns at start
MAX_OFFER_TTL_SECONDS=604800

# --- timing (seconds); raised to the contract's min_review_period_ns at start ---
# 259200 = 3 days
MIN_REVIEW_PERIOD_SECONDS=259200
MIN_DELIVERY_SECONDS=60

# --- arbiter tool (public key only; printed by the arbiter tool `keys` command) ---
# empty = the /api/arbiter/* routes do not exist
ARBITER_API_PUBLIC_KEY=

# --- rate limits (per minute) ---
RATE_READS_PER_MIN=120
RATE_WRITES_PER_MIN=20
RATE_INVALID_PER_MIN=30
RATE_SIGNER_PER_MIN=20
RATE_QUOTES_PER_MIN=10

# --- daily caps (rolling 24 h) ---
DAILY_OFFERS_PER_IP=50
DAILY_JOINS_PER_IP=20
DAILY_JOIN_CAP=500
DAILY_WITHDRAWS_PER_PARTY=5
DAILY_WITHDRAWS_PER_PREFIX=20
DAILY_TX_PER_DEAL=40
DAILY_REVOKE_SETTLE_PER_DEAL=5
DAILY_PAY_QUOTES_PER_DEAL=8
DAILY_ONCHAIN_REVOKES=50
# contract rejections per deal / join link in 10 min before a 10 min pause
CHAIN_FAILS_PER_DEAL=3
# deliver/dispute txs one network prefix may have waiting at once
MAX_QUEUED_CRITICAL_PER_PREFIX=3

# --- NEAR reserves and monitoring (NEAR, decimals allowed) ---
# non-time-critical txs pause (503) below this free relayer NEAR
ACTION_RESERVE_RELAYER_NEAR=0.15
# new joins pause (503 low_balance) below these
JOIN_RESERVE_ESCROW_NEAR=0.3
JOIN_RESERVE_RELAYER_NEAR=0.3
# /api/health warnings
LOW_BALANCE_RELAYER_NEAR=2
LOW_BALANCE_ESCROW_NEAR=1
OFFER_ALERT_THRESHOLD=1000

# --- marketplace ---
# Re-read not yet finished deals made from catalog requests this often (counters); 0 = off.
MARKET_REFRESH_SECONDS=600
# Marketplace: re-read the bios of confirmed creator accounts (YouTube / Behance) this often, in hours; 0 = off.
ACCOUNT_RECHECK_HOURS=24
# A review can be written or edited this long after the deal ended on-chain, then it is locked (default: 3 days).
REVIEW_WINDOW_SECONDS=259200

# --- AI brief helper on NEAR AI Cloud ---
# API key from cloud.near.ai. Empty = the helper is off (the site hides the button). Never sent to the browser.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# A PRIVATE (TEE), NON-thinking model; empty = z-ai/glm-5.3-flash. Check GET /v1/models before changing.
NEARAI_MODEL=
# Brief helper calls per IP per minute / per network per day.
RATE_BRIEF_PER_MIN=3
BRIEF_PER_DAY=30

# --- Telegram notification bot ---
# Both empty = the bot is off and the site hides the Telegram button.
# The token is a secret (from @BotFather): never commit or log it. Run only ONE
# server per token (the bot long-polls Telegram; no public webhook needed).
TELEGRAM_BOT_TOKEN=
# the bot's username, with or without "@"; printed on every deal page
TELEGRAM_BOT_USERNAME=
# how often the bot re-reads the subscribed deals (seconds, min 10)
NOTIFY_POLL_SECONDS=60
# "Report" button: the chat where our bot sends one short message
# per report. To get the id: open the chat (your private chat with the bot, or
# a team group the bot was added to) and send /chatid; the bot answers with it.
# Groups have negative ids. Empty = reports are only stored (scripts/reports.ts lists them).
TELEGRAM_REPORTS_CHAT_ID=
# Weekly volume alert: when the PAID deals made from requests to one creator
# profile pass this many USDC in a rolling 7 days, the chat above gets ONE
# message (no chat set = a warning line in the server log). Not repeated for
# the same profile within 7 days. Nothing is blocked. 0 = off.
VOLUME_ALERT_USDC=10000
