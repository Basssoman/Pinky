{
  "name": "private-escrow-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "API + relayer for the private creator escrow (NEAR + 1Click Intents)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/src/main.js",
    "dev": "node node_modules/typescript/bin/tsc && node --disable-warning=ExperimentalWarning dist/src/main.js",
    "test": "node node_modules/typescript/bin/tsc && node --disable-warning=ExperimentalWarning --test \"dist/test/*.test.js\"",
    "test:live": "node node_modules/typescript/bin/tsc && node --disable-warning=ExperimentalWarning --test dist/test/live/oneclick.live.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "e2e": "node node_modules/typescript/bin/tsc && node --disable-warning=ExperimentalWarning dist/scripts/e2e.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "fastify": "^5.12.7",
    "near-api-js": "^7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.26",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.0"
  }
}
